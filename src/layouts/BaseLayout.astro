---
import '@fontsource-variable/ibm-plex-sans'
import Footer from '@/components/Footer.astro'
import NavBar from '@/components/NavBar.astro'
import ibmPlexSansWoff2 from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';
import '../styles/main.css'
import '../styles/global.css'

const isProd = import.meta.env.PROD

interface Props {
  title: string
  keywords?: string[]
  description?: string
  lang?: string
  noIndex?: boolean
  pubDate?: Date
}

const {
  title,
  keywords = ['fwio', 'blog', 'ts', 'typescript', 'vue', 'react'],
  description = 'Write for myself, just for fun.',
  lang = 'en-US',
  noIndex = false,
  pubDate,
} = Astro.props

const canonicalUrl = new URL(
  Astro.url.pathname.replace(/(.)\/$/, '$1'),
  Astro.site,
)
---

<html lang={lang} class="scroll-smooth motion-reduce:scroll-auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? "nofollow, noindex" : "index, follow"} />
    {!noIndex && <link rel="canonical" href={canonicalUrl} />}
    <meta name="theme-color" content="#ffffff" />
    <meta name="author" content="Fwio" />
    <meta name="generator" content={Astro.generator} />
    <meta name="keywords" content={keywords.join(',')} />

    <meta property="og:site_name" content="Fwio" />
    <meta property="og:type" content={pubDate ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    <meta name="twitter:card" content="summary" />

    <link rel="icon" type="image/svg+xml" href="/fwio.svg" />
    <link rel="apple-touch-icon" href="/fwio-apple-touch.png" sizes="180x180" />
    <link rel="mask-icon" href="/fwio.svg" color="#FFFFFF" />
    <link rel="alternate" type="application/rss+xml" title="Fwio" href="/rss.xml" />
    <link rel="preload" as="font" type="font/woff2" href={ibmPlexSansWoff2} crossorigin="anonymous" />
    <slot name="head" />

    <script is:inline>
      ;(() => {
        const STORAGE_KEY = 'usehooks-ts-ternary-dark-mode'
        const darkQuery = window.matchMedia('(prefers-color-scheme: dark)')
        const themeColor = document.querySelector('meta[name="theme-color"]')

        function readPreference() {
          try {
            return JSON.parse(localStorage.getItem(STORAGE_KEY)) ?? 'system'
          } catch {
            return 'system'
          }
        }

        function applyTheme(preference = readPreference()) {
          const isDark =
            preference === 'dark' ||
            (preference === 'system' && darkQuery.matches)

          document.documentElement.classList.toggle('dark', isDark)
          themeColor?.setAttribute('content', isDark ? '#0a0a0a' : '#ffffff')
        }

        window.applyTheme = applyTheme
        darkQuery.addEventListener('change', () => applyTheme())
        applyTheme()
      })()
    </script>

    {
      isProd && (
        <>
          <link rel="preconnect" href="https://www.googletagmanager.com" />
          <script
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-Z0VQSCZHJ1"
            is:inline
          />
          <script is:inline>
            window.dataLayer = window.dataLayer || [];
            // eslint-disable-next-line prefer-rest-params
            function gtag() {dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', 'G-Z0VQSCZHJ1');
          </script>
          <script>
            import('@vercel/speed-insights').then(({ injectSpeedInsights }) => {
              injectSpeedInsights()
            })
          </script>
        </>
      )
    }
  </head>
  <body>
    <NavBar />
    <main class="min-h-[calc(100vh_-_3rem)] items-stretch px-6 py-10 bg-background">
      <slot />
      <Footer />
    </main>
    <!-- {
        !isPost && (
          <Image
            aria-hidden="true"
            src={Seagull}
            alt=""
            loading="eager"
            class="pointer-events-none fixed left-1/2 top-1/2 aspect-square h-auto max-w-[45%] -translate-x-1/2 -translate-y-1/2 opacity-45 md:max-w-[17%]"
          />
        )
      } -->
  </body>
</html>

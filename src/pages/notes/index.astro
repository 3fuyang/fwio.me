---
import PostList, { type PostFilter } from '@/components/PostList'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getPublishedPosts, toPostListItem } from '@/lib/posts'

const posts = (await getPublishedPosts('notes')).map((post) =>
  toPostListItem(post, [post.data.category]),
)

const filters: PostFilter[] = [
  { value: 'regular', label: 'Regular Notes' },
  { value: 'reading', label: 'Reading Notes' },
]
---

<BaseLayout title="Notes | Fwio">
  <PostList posts={posts} filters={filters} client:load />
</BaseLayout>

<script>
  import '@/scripts/post-view-transitions'
</script>

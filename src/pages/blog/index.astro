---
import PostList, { type PostFilter } from '@/components/PostList'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getPublishedPosts, toPostListItem } from '@/lib/posts'

const posts = (await getPublishedPosts('blog')).map((post) =>
  toPostListItem(post, post.data.lang ? [post.data.lang] : []),
)

const filters: PostFilter[] = [
  { value: 'en', label: 'English' },
  { value: 'zh', label: '中文' },
]
---

<BaseLayout title="Blog | Fwio">
  <PostList posts={posts} filters={filters} client:load />
</BaseLayout>

<script>
  import '@/scripts/post-view-transitions'
</script>
